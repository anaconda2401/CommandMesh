# CommandMesh Node Configuration
# Copy this file to .env and fill in your values.
# Never commit the real .env to version control.

# MQTT broker hostname (without protocol prefix).
# Example: your-cluster.s1.eu.hivemq.cloud
MQTT_BROKER=

# MQTT port (TLS). Default is 8883.
MQTT_PORT=8883

# MQTT credentials for your broker account.
MQTT_USERNAME=
MQTT_PASSWORD=

# Ed25519 public key(s) generated by the PWA controller.
# Multiple keys can be separated by commas.
MQTT_PUBLIC_KEYS=

# Enable or disable Ed25519 signature verification (PyNaCl).
# Set to 'false' to run in trust-all mode (useful for local testing).
# WARNING: Disabling this removes cryptographic authentication. Only do this
# on a private, fully-trusted network or during initial setup/debugging.
# Default: true
SIGNATURE_VERIFICATION=true

# Unique identifier for this node (no spaces, lowercase).
# Example: laptop, desktop_home, tv_node
NODE_ID=

# Human-readable display name shown in the PWA device list.
# Example: Work Laptop, Living Room TV
NODE_NAME=

# (Termux node only) ADB target address for non-rooted Android devices.
# Example: 127.0.0.1:5555
ADB_TARGET=127.0.0.1:5555
